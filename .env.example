NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_TENANT_ID=

# New phone authentication (keep false until Neon + SOLAPI are configured)
AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Neon pooled URL for runtime, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# SOLAPI: API credentials and an approved sender number (digits only)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# Provisioned master user ID for this database (never a client-controlled role)
ADMIN_USER_ID=

# App entitlement bridge: server-only credentials for the mobile Supabase project
MOBILE_SUPABASE_URL=
MOBILE_SUPABASE_SERVICE_ROLE_KEY=
